# Netlify Cache Headers for DUMA Admin Panel

# HTML files - short cache (always check for new version)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# JS & CSS bundles (hashed filenames) - cache for 1 year
/static/js/*
  Cache-Control: public, max-age=31536000, immutable

/static/css/*
  Cache-Control: public, max-age=31536000, immutable

# Media & font files - cache for 1 year
/static/media/*
  Cache-Control: public, max-age=31536000, immutable

# Manifest and icons - short cache
/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/favicon.ico
  Cache-Control: public, max-age=86400
